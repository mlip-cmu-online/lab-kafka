{
  "name": "MLiP Kafka Lab",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "portsAttributes": {
    "9092": {
      "label": "Kafka SSH tunnel",
      "onAutoForward": "ignore"
    }
  },
  "remoteUser": "vscode"
}
